{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": [
    {
      "key": "DATABASE_URL",
      "description": "Supabase PostgreSQL connection string"
    },
    {
      "key": "JWT_SECRET",
      "description": "Secret key for JWT token signing"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
