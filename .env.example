# Environment Variables Template
# Copy this to .env.local for local development
# For Vercel, set these in your project settings

# Supabase PostgreSQL Connection
# Get this from Supabase dashboard: Project Settings > Database > Connection String
DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]

# JWT Secret for authentication
# Generate a strong random string in production
JWT_SECRET=your-super-secret-key-change-in-production

# Environment
NODE_ENV=development

# API Base URL (for frontend requests)
# Local development: http://localhost:3000
# Production: https://your-domain.com
REACT_APP_API_URL=http://localhost:3000
